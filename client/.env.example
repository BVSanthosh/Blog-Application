# Client-side configuration. Everything here is compiled into the JS bundle and
# is therefore public — never put a secret in this file.
# Copy to client/.env and fill in.

# Clerk -> API keys -> publishable key.
VITE_CLERK_PUBLISHABLE_KEY="pk_test_..."

# ImageKit -> URL endpoint and public key.
VITE_IK_URL_ENDPOINT="https://ik.imagekit.io/your_imagekit_id"
VITE_IK_PUBLIC_KEY="public_..."

# Optional. Defaults to "/api", which is correct when the Worker serves both
# the SPA and the API. Only set this if the API moves to its own origin.
# VITE_API_URL="/api"
