{
  "name": "btechlogs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A developer blog platform, deployed as a single Cloudflare Worker serving both the SPA and the API.",
  "scripts": {
    "postinstall": "npm --prefix client install",
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "wrangler dev",
    "dev:web": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "lint": "npm --prefix client run lint",
    "db:setup": "node --env-file=.dev.vars scripts/setup-db.js",
    "cf-typegen": "wrangler types",
    "test": "node --experimental-test-module-mocks --test \"server/test/**/*.test.js\""
  },
  "dependencies": {
    "@clerk/backend": "^3.17.2",
    "hono": "^4.13.7",
    "mongodb": "^6.21.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "mongodb-memory-server": "^11.2.0",
    "svix": "^2.5.0",
    "wrangler": "^4.131.1"
  },
  "allowScripts": {
    "workerd@1.20260911.1": true,
    "esbuild@0.28.1": true,
    "mongodb-memory-server@11.2.0": true
  }
}
